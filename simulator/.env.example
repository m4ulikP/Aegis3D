# Aegis3D Virtual Sensor Simulator Configuration Template
# Copy this file to .env and adjust variables as needed.

# ==============================================================================
# 1. ONE-LAPTOP MODE (Simulator and FastAPI running on the same machine)
# ==============================================================================
BACKEND_URL=http://localhost:8000

# ==============================================================================
# 2. TWO-LAPTOP MODE (Simulator on Laptop 2, FastAPI on Laptop 1 over LAN)
# ==============================================================================
# Replace with Laptop 1's actual LAN IP address:
# BACKEND_URL=http://192.168.1.50:8000

# Telemetry ingestion route on backend
TELEMETRY_ENDPOINT=/api/v1/telemetry

# HTTP request timeout in seconds
TIMEOUT_SECONDS=5.0

# Default sampling rate in Hertz (samples per second)
DEFAULT_SAMPLE_RATE_HZ=1000.0

# Default sample count per telemetry batch
DEFAULT_SAMPLE_COUNT=1000
